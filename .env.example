# NiCE Club Rwanda — Attendance Platform Environment Variables

# Node Environment
NODE_ENV="development"
TZ="Africa/Kigali"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NiCE Club Rwanda — Attendance Platform"
NEXT_PUBLIC_ORG_NAME="NiCE Club Rwanda"
NEXT_PUBLIC_ORG_TAGLINE="Nuclear is Clean Energy"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://nice_admin:nice_secure_password@localhost:5432/nice_attendance?schema=public"
DATABASE_POOL_MAX="10"
# Set to true for hosted PostgreSQL. Remote database URLs enable TLS automatically when unset.
DATABASE_SSL="false"
# Optional: path to the provider's root CA certificate for verified TLS connections.
# DATABASE_SSL_CA_FILE="/absolute/path/to/supabase-prod-ca.crt"
# In Vercel, set DATABASE_SSL_CA to the PEM certificate contents instead of a local file path.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Required only when creating the initial administrator with `npm run db:seed-admin`.
INITIAL_ADMIN_NAME="NiCE Club Administrator"
INITIAL_ADMIN_EMAIL="admin@niceclub.rw"
INITIAL_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-14-chars"

# Authentication Security
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET="super-secret-random-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Rate Limiting & Abuse Prevention (Optional Redis or in-memory)
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE="60"

# Brevo transactional email. Create an API key in Brevo and use a verified sender.
# Keep BREVO_API_KEY only in the server's private .env; never use a NEXT_PUBLIC_ prefix.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="NiCE Club Rwanda"
# Optional: BREVO_REPLY_TO="info@niceclub.rw"
